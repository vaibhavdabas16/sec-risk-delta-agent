# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# OpenAI API key (required for Steps 1, 3, 4, 6)
OPENAI_API_KEY=sk-...

# Tavily API key for news search (required for Step 5)
# Get one free at https://tavily.com — 1000 searches/month on the free tier.
TAVILY_API_KEY=tvly-...

# SEC EDGAR User-Agent (required — SEC returns 403 without this)
# Format: "FirstName LastName email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com
